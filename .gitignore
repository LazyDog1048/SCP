# Unity generated folders (regenerated locally by each member)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
/MemoryCaptures/
/Recordings/

# Asset Store publishing tools
/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Never ignore asset meta data
!/[Aa]ssets/**/*.meta

# IDE caches and generated solution/project files
.vs/
.idea/
.vscode/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# Meta files Unity generates for debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and tool logs
sysinfo.txt
fmod_editor.log

# Build and export outputs
*.apk
*.aab
*.unitypackage

# OS files
.DS_Store
Thumbs.db

# Local credentials and machine-specific AI settings
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.keystore
*.jks
/.codex/
/.claude/

# Local source asset downloads (curated imports belong in Assets/)
/Downloads/ModelAssets/
